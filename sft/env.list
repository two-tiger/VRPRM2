# Shell-compatible environment list for Qwen3-VL-8B VisualPRM SFT.
# Usage: source this file or let train_qwen3vl8b_visualprm_sft.sh source it.

# Resolve the repository root relative to this file so the repo is portable.
VRPRM_SFT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
VRPRM_ROOT="${VRPRM_ROOT:-$(cd "${VRPRM_SFT_DIR}/.." && pwd)}"
export SWIFT_ROOT="${VRPRM_ROOT}/ms-swift"

# Base model. Either a local Hugging Face snapshot directory or a Hub model id.
MODEL_PATH="${MODEL_PATH:-Qwen/Qwen3-VL-8B-Instruct}"

# Generated rollout SFT data lives under rollout_outputs/ (not committed).
# Produce it with the rollout_*_sft_data_pipeline.py scripts, or restore it
# from your data release, before launching training.
export DATASET_PATHS="${VRPRM_ROOT}/rollout_outputs/rollout_sft_success_0615.json,${VRPRM_ROOT}/rollout_outputs/rollout_sft_success_0614.json"
export MERGED_DATASET_PATH="${VRPRM_ROOT}/rollout_outputs/rollout_sft_success_0614_0615.json"
export DATASET_PATH="${MERGED_DATASET_PATH}"
export OUTPUT_DIR="${VRPRM_ROOT}/sft/output/qwen3_vl_8b_visualprm_sft"

# Distributed/GPU runtime.
export CUDA_VISIBLE_DEVICES="1"
export NPROC_PER_NODE="1"
export MASTER_PORT="29501"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export TOKENIZERS_PARALLELISM="false"

# Qwen3-VL multimodal limits.
export IMAGE_MAX_TOKEN_NUM="1024"
export VIDEO_MAX_TOKEN_NUM="128"
export FPS_MAX_FRAMES="16"

# Training mode. lora_llm = LLM LoRA + full ViT/aligner training.
export TUNER_TYPE="lora_llm"
export TORCH_DTYPE="bfloat16"
export ATTN_IMPL="sdpa"
export DEEPSPEED=""

# Dataset and sequence handling.
export SPLIT_DATASET_RATIO="0.01"
export MAX_LENGTH="8192"
export PACKING="false"
export PADDING_FREE="false"
export LOAD_FROM_CACHE_FILE="true"

# Hyperparameters.
export NUM_TRAIN_EPOCHS="3"
export PER_DEVICE_TRAIN_BATCH_SIZE="2"
export PER_DEVICE_EVAL_BATCH_SIZE="2"
export GRADIENT_ACCUMULATION_STEPS="4"
export GRADIENT_CHECKPOINTING="true"
export VIT_GRADIENT_CHECKPOINTING="true"
export LEARNING_RATE="1e-4"
export VIT_LR="1e-5"
export ALIGNER_LR="1e-5"
export WARMUP_RATIO="0.05"
export LORA_RANK="16"
export LORA_ALPHA="32"

# Logging/checkpointing.
export LOGGING_STEPS="5"
export EVAL_STEPS="100"
export SAVE_STEPS="500"
export SAVE_TOTAL_LIMIT="3"
export DATASET_NUM_PROC="8"
export DATALOADER_NUM_WORKERS="8"
